{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "streamlit run app.py --server.port 8501 --server.address 0.0.0.0 --server.headless true",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE"
  }
}
 
